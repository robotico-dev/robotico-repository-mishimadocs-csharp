<Project>
  <PropertyGroup>
    <_RoboticoSharedMsbuildImport Condition="Exists('$(MSBuildThisFileDirectory)Robotico.Library.Shared.props')">$(MSBuildThisFileDirectory)Robotico.Library.Shared.props</_RoboticoSharedMsbuildImport>
    <_RoboticoSharedMsbuildImport Condition="'$(_RoboticoSharedMsbuildImport)' == ''">$([MSBuild]::GetPathOfFileAbove('Robotico.Library.Shared.props', '$(MSBuildThisFileDirectory)'))</_RoboticoSharedMsbuildImport>
  </PropertyGroup>
  <Import Project="$(_RoboticoSharedMsbuildImport)" Condition="'$(_RoboticoSharedMsbuildImport)' != ''" />

  <!-- MishimaDocs engine targets net10.0 only; this adapter must match for ProjectReference restore. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.1.2</Version>
    <Product>Robotico.Repository.MishimaDocs</Product>
    <PackageId>Robotico.Repository.MishimaDocs</PackageId>
    <Title>Robotico.Repository.MishimaDocs</Title>
    <Description>IRepository, IAsyncRepository, and IUnitOfWork backed by MishimaDocs (embedded document store). Each repository operation commits immediately when using sync collections; async writes use IMishimaAsyncCollection when the database supports async persistence. MishimaDocsUnitOfWork.CommitAsync is a no-op success for API parity; IUnitOfWorkCapabilities describes semantics.</Description>
    <PackageTags>repository;mishima;mishimadocs;robotico</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <_RoboticoCsharpNuGetsDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\nugets'))</_RoboticoCsharpNuGetsDir>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('$(_RoboticoCsharpNuGetsDir)')">
    <PackageOutputPath>$([MSBuild]::EnsureTrailingSlash('$(_RoboticoCsharpNuGetsDir)'))</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <MishimaDocsProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\mishima-suite\mishima-docs\src\MishimaDocs\MishimaDocs.csproj'))</MishimaDocsProjectPath>
  </PropertyGroup>
</Project>
